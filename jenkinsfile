pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/edionwe41/lms.git'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker build -t lms-backend ./backend'
                sh 'docker build -t lms-frontend ./frontend'
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                sh 'docker compose down || true'
                sh 'docker compose up -d'
            }
        }
    }
}
